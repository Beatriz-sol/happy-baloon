{
  "version": "2.0.0",
  "tasks": [
    {
      // Ctrl+Shift+B: compila e abre o jogo pelo rodar.bat (não depende da extensão Java)
      "label": "Rodar o jogo",
      "type": "shell",
      "command": "./rodar.sh",
      "windows": { "command": ".\\rodar.bat" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      // Terminal > Executar Tarefa > Gerar o .jar: cria codigo/dist/JogoBalao.jar
      "label": "Gerar o .jar",
      "type": "shell",
      "command": "./gerar-jar.sh",
      "windows": { "command": ".\\gerar-jar.bat" },
      "problemMatcher": []
    }
  ]
}
